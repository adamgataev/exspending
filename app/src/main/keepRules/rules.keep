# Room uses reflection for *_Impl classes (AGP 9 / R8 full mode).
-keep class * extends androidx.room.RoomDatabase {
    <init>();
    <methods>;
}
-keep class * extends androidx.room.RoomDatabase
-keep @androidx.room.Entity class *
-keep @androidx.room.Dao class *
-keep class * extends androidx.room.RoomOpenDelegate { *; }
-keep class * extends androidx.room.SharedSQLiteStatement { *; }
-keepclassmembers class **_Impl { public <init>(); }

# Keep app database / DAO impls explicitly.
-keep class com.example.exspending.data.ExspendingDatabase_Impl { public <init>(); }
-keep class com.example.exspending.data.dao.**_Impl { public <init>(); }
